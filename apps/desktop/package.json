{
	"name": "@boxiaolanya2008/pi-desktop",
	"version": "0.1.0",
	"private": true,
	"description": "Pi-Pi desktop shell",
	"type": "module",
	"main": "dist/main.mjs",
	"scripts": {
		"build": "node scripts/build.mjs",
		"start": "npm run dev",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"dist": "npm run build && electron-builder",
		"dist:win": "npm run build && electron-builder --win",
		"dist:linux": "npm run build && electron-builder --linux",
		"smoke": "node scripts/smoke.mjs",
		"dev": "npm run build && electron ."
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0"
	},
	"devDependencies": {
		"electron": "38.8.6",
		"electron-builder": "25.1.8"
	},
	"build": {
		"appId": "com.boxiaolanya2008.pipi",
		"productName": "Pi-Pi",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"package.json"
		],
		"win": {
			"target": [
				"nsis"
			],
			"executableName": "pipi"
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"category": "Development",
			"executableName": "pipi"
		},
		"executableName": "pipi"
	}
}
